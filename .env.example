# Kopieer naar .env en vul in. .env wordt NIET gecommit.
MENDRIX_BASE_URL=https://test.roemaat.nl:38001/api
MENDRIX_TOKEN=plak-hier-je-api-token

# Optioneel: als het API-token eerst ingewisseld moet worden voor een JWT bij de
# MendriX account service, vul hier de URL van dat endpoint in.
MENDRIX_AUTH_URL=
MENDRIX_AUTH_HEADER=Authorization
MENDRIX_AUTH_SCHEME=Bearer

# Endpoint-paden (relatief aan MENDRIX_BASE_URL). Controleer met:
#   python mendrix_files.py discover
MENDRIX_ORDER_SEARCH_PATH=/orders
MENDRIX_ORDER_NUMBER_PARAM=orderNumber
MENDRIX_ORDER_REFERENCE_PARAM=reference
MENDRIX_DOCUMENTS_PATH=/orders/{order_id}/documents
MENDRIX_DOCUMENT_DOWNLOAD_PATH=/orders/{order_id}/documents/{document_id}/content

MENDRIX_OUTPUT_DIR=downloads
# Zet op false bij een self-signed certificaat op de testomgeving.
MENDRIX_VERIFY_TLS=true
