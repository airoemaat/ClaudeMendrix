# Kopieer naar .env en vul in. .env wordt NIET gecommit.
MENDRIX_BASE_URL=http://test.roemaat.nl:38000/api
MENDRIX_TOKEN=plak-hier-je-api-token

# Het API-token wordt ingewisseld voor een kortlevend access-JWT via dit endpoint.
MENDRIX_AUTH_URL=/account/login-api-token
MENDRIX_AUTH_HEADER=Authorization
MENDRIX_AUTH_SCHEME=Bearer

# Endpoint-paden (relatief aan MENDRIX_BASE_URL).
# Bevestigd: heel orderdossier als zip.
MENDRIX_DOSSIER_ZIP_PATH=/dossier/dossiers/orders/{order_number}/zipped
# Nog niet bevestigd (alleen nodig voor zoeken op referentie). Controleer met:
#   python mendrix_files.py discover
MENDRIX_ORDER_SEARCH_PATH=/orders
MENDRIX_ORDER_NUMBER_PARAM=orderNumber
MENDRIX_ORDER_REFERENCE_PARAM=reference
MENDRIX_DOCUMENTS_PATH=/orders/{order_id}/documents
MENDRIX_DOCUMENT_DOWNLOAD_PATH=/orders/{order_id}/documents/{document_id}/content

MENDRIX_OUTPUT_DIR=downloads
# Zet op false bij een self-signed certificaat op de testomgeving.
MENDRIX_VERIFY_TLS=true

# --- Exact Globe Next (exact_mont_orders.py, alleen lezen) ---
EXACT_SQL_SERVER=SQLSERVER\EXACT
EXACT_SQL_DATABASE=001
# Leeg laten = Windows-authenticatie. Gebruik een login met alleen db_datareader.
EXACT_SQL_USER=
EXACT_SQL_PASSWORD=
EXACT_SQL_DRIVER=ODBC Driver 18 for SQL Server
EXACT_SQL_TRUST_CERT=true
EXACT_LEVERINGSWIJZE=MONT
# Kolom in orkrg met de ordernotitie; leeg = automatisch zoeken (opmerk, opm, notes, ...).
EXACT_NOTITIE_KOLOM=
