{
  "name": "MendriX - Bestanden uit orderdossier (formulier)",
  "nodes": [
    {
      "id": "95275685-bc3e-4895-8434-2d1096363f55",
      "name": "Ordernummer invullen",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.6,
      "position": [
        0,
        0
      ],
      "webhookId": "2395adf5-db1f-41b3-87bb-b495beff83f5",
      "parameters": {
        "formTitle": "Bestanden uit MendriX-orderdossier",
        "formDescription": "Vul een ordernummer in. Je krijgt een zip met alle bestanden uit het dossier van die order.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Ordernummer",
              "fieldName": "ordernummer",
              "fieldType": "text",
              "placeholder": "bijv. 1402685",
              "requiredField": true
            }
          ]
        },
        "responseMode": "lastNode",
        "options": {
          "appendAttribution": false,
          "buttonLabel": "Dossier ophalen",
          "path": "mendrix-dossier"
        }
      }
    },
    {
      "id": "7886761c-56bb-4d32-ab33-57a278eda3b8",
      "name": "Configuratie",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "base",
              "name": "restBaseUrl",
              "value": "http://test.roemaat.nl:38000/api",
              "type": "string"
            },
            {
              "id": "ord",
              "name": "ordernummer",
              "value": "={{ String($json.ordernummer ?? \"\").trim() }}",
              "type": "string"
            },
            {
              "id": "tok",
              "name": "apiToken",
              "value": "<VUL HIER HET MENDRIX API-TOKEN IN>",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "d833719d-e957-49a4-8098-f56a5c8bf260",
      "name": "Dossier downloaden (zip)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        660,
        -220
      ],
      "onError": "continueErrorOutput",
      "parameters": {
        "method": "GET",
        "url": "={{ $('Configuratie').first().json.restBaseUrl }}/dossier/dossiers/orders/{{ encodeURIComponent($('Configuratie').first().json.ordernummer) }}/zipped",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.data.items[0].access }}"
            },
            {
              "name": "Accept",
              "value": "*/*"
            }
          ]
        },
        "options": {
          "allowUnauthorizedCerts": true,
          "timeout": 30000,
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        }
      }
    },
    {
      "id": "b0e0bcd2-d2ab-4f7f-aa58-a9e2f9b7c5ff",
      "name": "Zip benoemen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        -220
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// MendriX geeft het dossier als bestand terug; volgens de docs kan het ook JSON met { buffer, contentType } zijn.\nconst nr = $('Configuratie').first().json.ordernummer;\nconst item = $input.first();\nconst fileName = `dossier_order_${nr}.zip`;\n\nif (item.binary && item.binary.data) {\n  const raw = await this.helpers.getBinaryDataBuffer(0, 'data');\n  const text = raw.subarray(0, 1).toString();\n  if (text !== '{') {\n    item.binary.data.fileName = fileName;\n    item.binary.data.mimeType = 'application/zip';\n    item.binary.data.fileExtension = 'zip';\n    return [{ json: { ordernummer: nr, grootte: raw.length }, binary: { data: item.binary.data } }];\n  }\n  item.json = JSON.parse(raw.toString('utf8'));\n}\n\nconst entry = item.json?.data?.items?.[0];\nif (!entry || entry.buffer == null) {\n  throw new Error('Geen bestand in antwoord van MendriX: ' + JSON.stringify(item.json).slice(0, 300));\n}\nconst bytes = typeof entry.buffer === 'string'\n  ? Buffer.from(entry.buffer, 'base64')\n  : Buffer.from(entry.buffer.data ?? entry.buffer);\nconst binary = await this.helpers.prepareBinaryData(bytes, fileName, entry.contentType || 'application/zip');\nreturn [{ json: { ordernummer: nr, grootte: bytes.length }, binary: { data: binary } }];"
      }
    },
    {
      "id": "3e5525ff-7e97-4a62-ae58-6b7e3443faa0",
      "name": "Zip teruggeven",
      "type": "n8n-nodes-base.form",
      "typeVersion": 2.5,
      "position": [
        1100,
        -220
      ],
      "webhookId": "dcc39dcb-7d08-4589-a3bc-f581a9c8eee8",
      "parameters": {
        "operation": "completion",
        "respondWith": "returnBinary",
        "completionTitle": "Dossier gevonden",
        "completionMessage": "=De bestanden van order {{ $json.ordernummer }} worden gedownload als zip.",
        "inputDataFieldName": "data"
      }
    },
    {
      "id": "e2266820-21b2-42db-9079-097682f03dce",
      "name": "Foutmelding tonen",
      "type": "n8n-nodes-base.form",
      "typeVersion": 2.5,
      "position": [
        880,
        0
      ],
      "webhookId": "58a09de4-da0e-45d5-a7a5-21d834ff0af0",
      "parameters": {
        "operation": "completion",
        "respondWith": "text",
        "completionTitle": "Dossier niet opgehaald",
        "completionMessage": "=Order {{ $('Configuratie').first().json.ordernummer }}: {{ $json.error?.message ?? $json.message ?? 'onbekende fout' }}"
      }
    },
    {
      "id": "8a9a90e5-0f08-4149-a7d1-c2beefbcb856",
      "name": "Inloggen (API-token)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        440,
        -220
      ],
      "onError": "continueErrorOutput",
      "parameters": {
        "method": "POST",
        "url": "={{ $json.restBaseUrl }}/account/login-api-token",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ token: $json.apiToken }) }}",
        "options": {
          "timeout": 30000
        }
      }
    }
  ],
