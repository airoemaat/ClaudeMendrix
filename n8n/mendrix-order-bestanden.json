{
  "name": "MendriX - Bestanden uit orderdossier (formulier)",
  "nodes": [
    {
      "id": "95275685-bc3e-4895-8434-2d1096363f55",
      "name": "Ordernummer invullen",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.6,
      "position": [
        0,
        0
      ],
      "webhookId": "2395adf5-db1f-41b3-87bb-b495beff83f5",
      "parameters": {
        "formTitle": "Bestanden uit MendriX-orderdossier",
        "formDescription": "Vul een ordernummer in. Je krijgt een zip met alle bestanden uit het dossier van die order.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Ordernummer",
              "fieldName": "ordernummer",
              "fieldType": "text",
              "placeholder": "bijv. 1402685",
              "requiredField": true
            }
          ]
        },
        "responseMode": "lastNode",
        "options": {
          "appendAttribution": false,
          "buttonLabel": "Dossier ophalen",
          "path": "mendrix-dossier"
        }
      }
    },
    {
      "id": "7886761c-56bb-4d32-ab33-57a278eda3b8",
      "name": "Configuratie",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "base",
              "name": "restBaseUrl",
              "value": "https://test.roemaat.nl:38001/api",
              "type": "string"
            },
            {
              "id": "ord",
              "name": "ordernummer",
              "value": "={{ String($json.ordernummer ?? \"\").trim() }}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "d833719d-e957-49a4-8098-f56a5c8bf260",
      "name": "Dossier downloaden (zip)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        440,
        0
      ],
      "onError": "continueErrorOutput",
      "credentials": {
        "httpTemplatedCustomAuth": {
          "id": "",
          "name": "MendriX Custom Link Bearer (test)"
        }
      },
      "parameters": {
        "method": "GET",
        "url": "={{ $json.restBaseUrl }}/dossier/dossiers/order/{{ encodeURIComponent($json.ordernummer) }}/zipped",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpTemplatedCustomAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "*/*"
            }
          ]
        },
        "options": {
          "allowUnauthorizedCerts": true,
          "timeout": 30000,
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        }
      }
    },
    {
      "id": "b0e0bcd2-d2ab-4f7f-aa58-a9e2f9b7c5ff",
      "name": "Zip benoemen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        -100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const nr = $('Configuratie').first().json.ordernummer;\nreturn $input.all().map(item => {\n  if (item.binary && item.binary.data) {\n    item.binary.data.fileName = `dossier_order_${nr}.zip`;\n    item.binary.data.mimeType = 'application/zip';\n    item.binary.data.fileExtension = 'zip';\n  }\n  return { json: { ordernummer: nr }, binary: item.binary };\n});"
      }
    },
    {
      "id": "3e5525ff-7e97-4a62-ae58-6b7e3443faa0",
      "name": "Zip teruggeven",
      "type": "n8n-nodes-base.form",
      "typeVersion": 2.5,
      "position": [
        880,
        -100
      ],
      "webhookId": "dcc39dcb-7d08-4589-a3bc-f581a9c8eee8",
      "parameters": {
        "operation": "completion",
        "respondWith": "returnBinary",
        "completionTitle": "Dossier gevonden",
        "completionMessage": "=De bestanden van order {{ $json.ordernummer }} worden gedownload als zip.",
        "inputDataFieldName": "data"
      }
    },
    {
      "id": "e2266820-21b2-42db-9079-097682f03dce",
      "name": "Foutmelding tonen",
      "type": "n8n-nodes-base.form",
      "typeVersion": 2.5,
      "position": [
        660,
        120
      ],
      "webhookId": "58a09de4-da0e-45d5-a7a5-21d834ff0af0",
      "parameters": {
        "operation": "completion",
        "respondWith": "text",
        "completionTitle": "Dossier niet opgehaald",
        "completionMessage": "=Order {{ $('Configuratie').first().json.ordernummer }}: {{ $json.error?.message ?? $json.message ?? 'onbekende fout' }}"
      }
    }
  ],
  "connections": {
    "Ordernummer invullen": {
      "main": [
        [
          {
            "node": "Configuratie",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Configuratie": {
      "main": [
        [
          {
            "node": "Dossier downloaden (zip)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Dossier downloaden (zip)": {
      "main": [
        [
          {
            "node": "Zip benoemen",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Foutmelding tonen",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Zip benoemen": {
      "main": [
        [
          {
            "node": "Zip teruggeven",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}